---
import Audio from "@/components/Audio.astro";
---

<style>
  table {
    text-align: center;
  }
  td:last-child {
    text-align: initial;
  }
</style>
<table>
  <thead>
    <tr>
      <th>verbum</th>
      <th>significatio</th>
      <th>consilium</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <Audio td from="linku/asi" file="mi" />
      <td>ego, nos</td>
      <td>pronuntiatio similis nominis contracti <i>mihi</i>! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="wan" />
      <td>unus</td>
      <td>emento pronuntiationem litterae <b>w</b>! (sicut <i>van</i> in pronuntiatione restituta) </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="jelo" />
      <td>flavus</td>
      <td>memento pronuntiationem litterae <b>j</b>! (sicut <i>ielo</i>) </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="waso" />
      <td>avis</td>
      <td>nec longae nec breves pronuntiare conare! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="nanpa" />
      <td>numerus</td>
      <td>similis linguae Latinae, sonus qui litteris <b>np</b> scribitur ut <b>mp</b> pronuntiatur! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="kalama" />
      <td>sonus</td>
      <td>pone accentum in prima syllaba! </td>
    </tr>
    <tr>
      <Audio td from="linku/asi" file="akesi" />
      <td>lacerta</td>
      <td>verba a vocale incipere possunt! </td>
    </tr>
  </tbody>
</table>
